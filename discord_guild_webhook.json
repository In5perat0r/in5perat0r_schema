{
    "$id": "https://github.com/In5perat0r/in5perat0r_schema/blob/main/discord_guild_webhook.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "username": {
            "type": "string"
        },
        "avatar_url": {
            "type": "string",
            "format": "uri"
        },
        "content": {
            "type": "string",
            "maxLength": 2000
        },
        "embeds": {
            "type": "array",
            "maxItems": 10,
            "items": {
                "type": "object",
                "properties": {
                    "color": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16777215
                    },
                    "author": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "maxLength": 256
                            },
                            "url": {
                                "type": "string",
                                "format": "uri"
                            },
                            "icon_url": {
                                "type": "string",
                                "format": "uri"
                            }
                        }
                    },
                    "title": {
                        "type": "string",
                        "maxLength": 256
                    },
                    "url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 4096
                    },
                    "fields": {
                        "type": "array",
                        "maxItems": 25,
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "maxLength": 256
                                },
                                "value": {
                                    "type": "string",
                                    "maxLength": 1024
                                },
                                "inline": {
                                    "type": "boolean"
                                }
                            },
                            "required": [
                                "name",
                                "value"
                            ]
                        }
                    },
                    "thumbnail": {
                        "type": "object",
                        "properties": {
                            "url": {
                                "type": "string",
                                "format": "uri"
                            }
                        },
                        "required": [
                            "url"
                        ]
                    },
                    "image": {
                        "type": "object",
                        "properties": {
                            "url": {
                                "type": "string",
                                "format": "uri"
                            }
                        },
                        "required": [
                            "url"
                        ]
                    },
                    "footer": {
                        "type": "object",
                        "properties": {
                            "text": {
                                "type": "string",
                                "maxLength": 2048
                            },
                            "icon_url": {
                                "type": "string",
                                "format": "uri"
                            }
                        },
                        "required": [
                            "text"
                        ]
                    },
                    "timestamp": {
                        "type": "string",
                        "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9])(\\.\\d{1,3})?Z$",
                        "examples": [
                            "2026-08-24T19:15:51Z",
                            "2026-08-24T19:15:51.123Z"
                        ]
                    }
                }
            }
        },
        "poll": {
            "type": "object",
            "properties": {
                "question": {
                    "type": "object",
                    "properties": {
                        "text": {
                            "type": "string",
                            "maxLength": 300
                        }
                    },
                    "required": [
                        "text"
                    ]
                },
                "answers": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                        "type": "object",
                        "properties": {
                            "poll_media": {
                                "type": "object",
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "maxLength": 55
                                    },
                                    "emoji": {
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "string"
                                            },
                                            "name": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "duration": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                },
                "allow_multiselect": {
                    "type": "boolean"
                }
            },
            "required": [
                "question",
                "answers",
                "duration"
            ]
        },
        "tts": {
            "type": "boolean"
        },
        "allowed_mentions": {
            "type": "object",
            "properties": {
                "parse": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "roles",
                            "users",
                            "everyone"
                        ]
                    }
                },
                "roles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "maxItems": 100
                },
                "users": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "maxItems": 100
                }
            }
        }
    },
    "anyOf": [
        {
            "required": [
                "content"
            ]
        },
        {
            "required": [
                "embeds"
            ]
        },
        {
            "required": [
                "poll"
            ]
        }
    ]
}