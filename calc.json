{
    "$id": "https://github.com/In5perat0r/in5perat0r_schema/blob/main/calc.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "inputProperty": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": ["value", "variable"]
                },
                "property": {}
            },
            "additionalProperties": false,
            "required": ["mode", "property"],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "value"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "property": {
                                "type": "number"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "variable"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "property": {
                                "type": "string"
                            }
                        }
                    }
                }
            ]
        },
        "outputProperty": {
            "type": "object",
            "properties": {
                "variable": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "required": ["variable"]
        },
        "doubleInputs": {
            "type": "object",
            "properties": {
                "first": {"$ref": "#/$defs/inputProperty"},
                "second": {"$ref": "#/$defs/inputProperty"}
            },
            "additionalProperties": false,
            "required": ["first", "second"]
        },
        "singleInput": {
            "type": "object",
            "properties": {
                "number": {"$ref": "#/$defs/inputProperty"}
            },
            "additionalProperties": false,
            "required": ["number"]
        }
    },
    "type": "object",
    "properties": {
        "$schema": {},
        "profile_name": {
            "type": "string"
        },
        "inputs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*$"
                    },
                    "input_type": {
                        "type": "string",
                        "enum": ["string", "number"]
                    }
                },
                "additionalProperties": false,
                "required": ["label", "key", "input_type"]
            }
        },
        "outputs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*$"
                    }
                },
                "additionalProperties": false,
                "required": ["label", "key"]
            }
        },
        "eval": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": ["simple", "advanced"]
                },
                "configuration": { "type": "object" }
            },
            "additionalProperties": false,
            "required": ["mode", "configuration"],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "simple"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "type": "object",
                                "properties": {
                                    "commands": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "mode": {
                                                    "type": "string",
                                                    "enum": ["add", "subtract", "multiply", "divide", "square"]
                                                },
                                                "inputs": {
                                                    "type": "object"
                                                },
                                                "outputs": {
                                                    "type": "object"
                                                }
                                            },
                                            "additionalProperties": false,
                                            "required": ["mode", "inputs", "outputs"],
                                            "allOf": [
                                                {
                                                    "if": {
                                                        "properties": {
                                                            "mode": {
                                                                "enum": ["add", "subtract", "multiply", "divide"]
                                                            }
                                                        }
                                                    },
                                                    "then": {
                                                        "properties": {
                                                            "inputs": {"$ref": "#/$defs/doubleInputs"},
                                                            "outputs": {"$ref": "#/$defs/outputProperty"}
                                                        }
                                                    }
                                                },
                                                {
                                                    "if": {
                                                        "properties": {
                                                            "mode": {
                                                                "const": "square"
                                                            }
                                                        }
                                                    },
                                                    "then": {
                                                        "properties": {
                                                            "inputs": {"$ref": "#/$defs/singleInput"},
                                                            "outputs": {"$ref": "#/$defs/outputProperty"}
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "advanced"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "type": "object",
                                "properties": {
                                    "script": {
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false,
                                "required": ["script"]
                            }
                        }
                    }
                }
            ]
        }
    },
    "additionalProperties": false,
    "required": ["profile_name", "inputs", "outputs", "eval"]
}