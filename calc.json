{
    "$id": "https://github.com/In5perat0r/in5perat0r_schema/blob/main/calc.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "$schema": {},
        "profile_name": {
            "type": "string"
        },
        "inputs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*$"
                    },
                    "input_type": {
                        "enum": ["string", "number"]
                    }
                },
                "additionalProperties": false
            }
        },
        "outputs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*$"
                    }
                },
                "additionalProperties": false
            }
        },
        "eval": {
            "type": "string"
        }
    },
    "additionalProperties": false,
    "required": ["profile_name", "inputs", "outputs", "eval"]
}