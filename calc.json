{
    "$id": "https://github.com/In5perat0r/in5perat0r_schema/blob/main/calc.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "$schema": {},
        "profile_name": {
            "type": "string"
        },
        "inputs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*$"
                    },
                    "input_type": {
                        "enum": ["string", "number"]
                    }
                },
                "additionalProperties": false
            }
        },
        "outputs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*$"
                    }
                },
                "additionalProperties": false
            }
        },
        "eval": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": ["simple", "advanced"]
                },
                "configuration": { "type": "object" }
            },
            "additionalProperties": false,
            "required": ["mode", "configuration"],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "simple"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "type": "object",
                                "properties": {
                                    "commands": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "mode": {
                                                    "type": "string",
                                                    "enum": ["add", "subtract", "multiply", "divide", "square"]
                                                },
                                                "inputs": {
                                                    "type": "object"
                                                }
                                            },
                                            "additionalProperties": false,
                                            "required": ["mode", "inputs"],
                                            "allOf": [
                                                {
                                                    "if": {
                                                        "properties": {
                                                            "mode": {
                                                                "const": "add"
                                                            }
                                                        }
                                                    },
                                                    "then": {
                                                        "properties": {
                                                            "inputs": {
                                                                "type": "object",
                                                                "properties": {
                                                                    "first": {
                                                                        "type": "number"
                                                                    },
                                                                    "second": {
                                                                        "type": "number"
                                                                    }
                                                                },
                                                                "additionalProperties": false,
                                                                "required": ["first", "second"]
                                                            }
                                                        }
                                                    }
                                                },
                                                {
                                                    "if": {
                                                        "properties": {
                                                            "mode": {
                                                                "const": "subtract"
                                                            }
                                                        }
                                                    },
                                                    "then": {
                                                        "properties": {
                                                            "inputs": {
                                                                "type": "object",
                                                                "properties": {
                                                                    "first": {
                                                                        "type": "number"
                                                                    },
                                                                    "second": {
                                                                        "type": "number"
                                                                    }
                                                                },
                                                                "additionalProperties": false,
                                                                "required": ["first", "second"]
                                                            }
                                                        }
                                                    }
                                                },
                                                {
                                                    "if": {
                                                        "properties": {
                                                            "mode": {
                                                                "const": "multiply"
                                                            }
                                                        }
                                                    },
                                                    "then": {
                                                        "properties": {
                                                            "inputs": {
                                                                "type": "object",
                                                                "properties": {
                                                                    "first": {
                                                                        "type": "number"
                                                                    },
                                                                    "second": {
                                                                        "type": "number"
                                                                    }
                                                                },
                                                                "additionalProperties": false,
                                                                "required": ["first", "second"]
                                                            }
                                                        }
                                                    }
                                                },
                                                {
                                                    "if": {
                                                        "properties": {
                                                            "mode": {
                                                                "const": "divide"
                                                            }
                                                        }
                                                    },
                                                    "then": {
                                                        "properties": {
                                                            "inputs": {
                                                                "type": "object",
                                                                "properties": {
                                                                    "first": {
                                                                        "type": "number"
                                                                    },
                                                                    "second": {
                                                                        "type": "number"
                                                                    }
                                                                },
                                                                "additionalProperties": false,
                                                                "required": ["first", "second"]
                                                            }
                                                        }
                                                    }
                                                },
                                                {
                                                    "if": {
                                                        "properties": {
                                                            "mode": {
                                                                "const": "square"
                                                            }
                                                        }
                                                    },
                                                    "then": {
                                                        "properties": {
                                                            "inputs": {
                                                                "type": "object",
                                                                "properties": {
                                                                    "number": {
                                                                        "type": "number"
                                                                    }
                                                                },
                                                                "additionalProperties": false,
                                                                "required": ["number"]
                                                            }
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "mode": {
                                "const": "advanced"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "configuration": {
                                "type": "object",
                                "properties": {
                                    "script": {
                                        "type": "string"
                                    }
                                },
                                "additionalProperties": false,
                                "required": ["script"]
                            }
                        }
                    }
                }
            ]
        }
    },
    "additionalProperties": false,
    "required": ["profile_name", "inputs", "outputs", "eval"]
}